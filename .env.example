# YTS local/server inference configuration.
# Copy to .env for local development. Do not commit real secrets.
# To use a config outside the working directory, set YTS_CONFIG_FILE=/absolute/path/to/yts.env.

# echo | cloud | openai | candle | pro-fixture
YTS_INFERENCE_BACKEND=openai

# OpenAI-compatible text model.
YTS_OPENAI_API_KEY=
YTS_OPENAI_TEXT_MODEL=gpt-4.1-mini

# Optional. Leave empty for the default OpenAI endpoint.
YTS_OPENAI_BASE_URL=

# Required for auth. Must be at least 32 UTF-8 bytes for HS256.
YTS_AUTH_JWT_SECRET=dev-yts-auth-secret-that-is-long-enough-for-hs256
