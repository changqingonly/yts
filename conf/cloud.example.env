# Cloud profile configuration template.
# Copy to conf/cloud.env and fill real values locally.

YTS_PROFILE=cloud

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
# local | cloud
YTS_INFERENCE_BACKEND=cloud
YTS_ALLOW_CUSTOM_SKILLS=false
YTS_BILLING_ENABLED=true

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# auto | console | json
YTS_LOGGING_FORMAT=auto
YTS_LOGGING_LEVEL=INFO
YTS_LOGGING_DIR=run
YTS_LOGGING_BACKEND_FILE=yts-server-{profile}.log
YTS_LOGGING_FRONTEND_FILE=yts-frontend-{profile}.log
YTS_PHOENIX_ENABLED=false

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
YTS_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
YTS_DATABASE_ECHO=false

# ------------------------------------------------------------
# Auth and storage
# ------------------------------------------------------------
YTS_AUTH_JWT_SECRET=
YTS_AUTH_ACCESS_TOKEN_TTL_SECONDS=1800
YTS_AUTH__PRODUCTION=false
YTS_AUTH__COOKIE_SECURE=false
YTS_AVATAR_STORAGE_DIR=public/avatars
YTS_LOCAL_IMPORT_STORAGE_DIR=public/uploads
YTS_PLAYBACK_RENDITION_STORAGE_DIR=public/playback_renditions
YTS_MODEL_ARTIFACT_STORAGE_DIR=artifacts/download

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
YTS_SERVER_ALLOWED_ORIGINS=["http://127.0.0.1:1420","http://localhost:1420","tauri://localhost"]

# ------------------------------------------------------------
# LangGraph checkpoint
# ------------------------------------------------------------
# memory | postgres
YTS_LANGGRAPH_CHECKPOINT_BACKEND=postgres
YTS_LANGGRAPH_CHECKPOINT_POSTGRES_DSN=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ------------------------------------------------------------
# LiteLLM cloud text backend
# ------------------------------------------------------------
YTS_DEFAULT_TEXT_MODEL=deepseek/deepseek-v4-pro
YTS_MODEL_FALLBACKS=["deepseek/deepseek-v4-flash"]

# ------------------------------------------------------------
# DeepSeek text model
# ------------------------------------------------------------
YTS_DEEPSEEK_API_KEY=
YTS_DEEPSEEK_TEXT_MODEL=deepseek-v4-pro
YTS_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
YTS_DEEPSEEK_REQUEST_TIMEOUT_SECONDS=180
YTS_DEEPSEEK_MAX_RETRIES=0

# ------------------------------------------------------------
# OpenAI-compatible models
# ------------------------------------------------------------
YTS_OPENAI_API_KEY=
YTS_OPENAI_TEXT_MODEL=gpt-5.5
YTS_OPENAI_IMAGE_MODEL=gpt-image-1
YTS_OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
YTS_OPENAI_BASE_URL=https://ai.xiaomifgobackhome.top:8088/v1
YTS_OPENAI_REQUEST_TIMEOUT_SECONDS=180
YTS_OPENAI_MAX_RETRIES=0

# ------------------------------------------------------------
# Candle local text backend
# ------------------------------------------------------------
YTS_GATEWAY_BASE_URL=http://127.0.0.1:8799
YTS_GATEWAY_TEXT_MAX_TOKENS=256
YTS_GATEWAY_REQUEST_TIMEOUT_SECONDS=120

# ------------------------------------------------------------
# Reserved model slots; provider routes are not implemented yet.
# ------------------------------------------------------------
YTS_IMAGE_PROVIDER=openai
YTS_IMAGE_MODEL=gpt-image-1
YTS_AUDIO_EFFECT_PROVIDER=
YTS_AUDIO_EFFECT_MODEL=
YTS_MUSIC_PROVIDER=
YTS_MUSIC_MODEL=
