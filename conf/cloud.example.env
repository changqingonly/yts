# Cloud profile. Copy to cloud.env and set required secrets before use.
YTS_PROFILE=cloud
YTS_DATABASE_URL=postgresql+asyncpg://127.0.0.1/yts
YTS_DATABASE_ECHO=false
YTS_DEFAULT_TEXT_MODEL=deepseek/deepseek-chat
YTS_MODEL_FALLBACKS=["openai/gpt-5.5"]
YTS_INFERENCE_BACKEND=cloud
YTS_DEEPSEEK_API_KEY=
YTS_DEEPSEEK_TEXT_MODEL=deepseek/deepseek-chat
YTS_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
YTS_DEEPSEEK_REQUEST_TIMEOUT_SECONDS=180
YTS_DEEPSEEK_MAX_RETRIES=0
YTS_OPENAI_API_KEY=
YTS_OPENAI_TEXT_MODEL=gpt-5.5
YTS_OPENAI_IMAGE_MODEL=gpt-image-1
YTS_OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
YTS_OPENAI_BASE_URL=
YTS_OPENAI_REQUEST_TIMEOUT_SECONDS=180
YTS_OPENAI_MAX_RETRIES=0
YTS_GATEWAY_BASE_URL=http://127.0.0.1:8799
YTS_GATEWAY_TEXT_MAX_TOKENS=256
YTS_GATEWAY_REQUEST_TIMEOUT_SECONDS=120
YTS_IMAGE_PROVIDER=openai
YTS_IMAGE_MODEL=gpt-image-1
YTS_AUDIO_EFFECT_PROVIDER=
YTS_AUDIO_EFFECT_MODEL=
YTS_MUSIC_PROVIDER=
YTS_MUSIC_MODEL=
YTS_ALLOW_CUSTOM_SKILLS=false
YTS_BILLING_ENABLED=true
YTS_PHOENIX_ENABLED=false
YTS_AUTH_JWT_SECRET=
YTS_AUTH_ACCESS_TOKEN_TTL_SECONDS=2592000
YTS_AVATAR_STORAGE_DIR=run/avatars
YTS_LOCAL_IMPORT_STORAGE_DIR=run/local_imports
YTS_LANGGRAPH_CHECKPOINT_BACKEND=postgres
YTS_LANGGRAPH_CHECKPOINT_POSTGRES_DSN=
YTS_LOGGING_LEVEL=INFO
YTS_LOGGING_FORMAT=auto
YTS_LOGGING_DIR=run
YTS_LOGGING_BACKEND_FILE=yts-server-{profile}.log
YTS_LOGGING_FRONTEND_FILE=yts-frontend-{profile}.log
YTS_SERVER_ALLOWED_ORIGINS=["http://127.0.0.1:1420","http://localhost:1420"]
