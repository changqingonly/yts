{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yts",
  "version": "0.1.0",
  "identifier": "com.yuetools.yts",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "yts", "width": 1100, "height": 720 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "app",
    "externalBin": ["bin/yts-sidecar", "bin/infer-gateway"],
    "resources": ["../components.toml"]
  }
}
